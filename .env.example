# Public site URL, used for metadata, Open Graph tags, robots.txt and sitemap.xml.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WordPress REST API base URL, for dynamic content (blogs, gallery,
# freebies, recommendations, lab resources — see WORDPRESS_CMS.md).
# WORDPRESS_API_URL=https://cms.example.com/wp-json/wp/v2

# Shared secret WordPress sends in the x-recap-revalidate-secret header when
# calling POST /api/revalidate on publish/update.
# WORDPRESS_REVALIDATE_SECRET=change-me

# Hostname WordPress serves media from, used for next/image remotePatterns.
# WORDPRESS_MEDIA_HOSTNAME=cms.example.com
