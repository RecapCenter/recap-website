# Public site URL, used for canonical URLs, Open Graph tags, robots.txt and
# sitemap.xml (lib/site-url.ts). Production builds FAIL unless this is the
# real https domain (https://recapcenter.com) — not localhost, not http, not
# a *.vercel.app alias. Previews fall back to their own URL when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4 Measurement ID (GA → Admin → Data streams → Web).
# Analytics only loads when this is set — leave it unset for local/preview.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# WordPress REST API base URL, for dynamic content (blogs, gallery,
# freebies, recommendations, lab resources — see WORDPRESS_CMS.md).
# WORDPRESS_API_URL=https://cms.example.com/wp-json/wp/v2

# Shared secret between WordPress (RECAP_REVALIDATE_SECRET in wp-config.php)
# and this site. Used both ways: WordPress sends it when calling
# POST /api/revalidate on publish/update, and this site sends it when
# forwarding footer newsletter signups to WordPress/MailPoet
# (POST /api/newsletter → /wp-json/recap/v1/subscribe). Must match exactly.
# WORDPRESS_REVALIDATE_SECRET=change-me

# Hostname WordPress serves media from, used for next/image remotePatterns.
# WORDPRESS_MEDIA_HOSTNAME=cms.example.com

# Google Places API (New) credentials for pulling Google Business reviews
# into the reviews list alongside CMS reviews (homepage marquee + /reviews
# page). Optional — when unset, only CMS testimonials show. The key needs
# "Places API (New)" enabled; the Place ID is the business's Google place_id.
# GOOGLE_PLACES_API_KEY=change-me
# GOOGLE_PLACE_ID=ChIJxxxxxxxxxxxxxxxxxxxx

# Inbox that receives contact form submissions (POST /api/contact).
# Required — the form fails with an error rather than guessing a fallback.
# CONTACT_RECIPIENT=contact@recapcenter.com

# SMTP credentials the contact form uses to send those submissions.
# recapcenter.com mail is on
# Google Workspace: use smtp.gmail.com / 465 and a Google *app password*
# (Google Account → Security → 2-Step Verification → App passwords), never
# the account's normal login password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=riya.kapoor@recapcenter.com
# SMTP_PASSWORD=change-me
# SMTP_FROM_NAME=Recap Website
